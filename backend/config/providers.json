{
  "version": "1.0.0",
  "providers": [
    {
      "id": "postgresql",
      "name": "postgresql",
      "displayName": "PostgreSQL",
      "icon": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg",
      "description": "PostgreSQL is a powerful, open source object-relational database system",
      "defaultPort": 5432,
      "fields": [
        {
          "key": "name",
          "label": "Connection Name",
          "type": "text",
          "placeholder": "My PostgreSQL DB",
          "required": true,
          "helpText": "A friendly name to identify this connection"
        },
        {
          "key": "host",
          "label": "Host",
          "type": "text",
          "placeholder": "localhost",
          "defaultValue": "localhost",
          "required": true,
          "helpText": "Server hostname or IP address"
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "placeholder": "5432",
          "defaultValue": 5432,
          "required": true,
          "helpText": "PostgreSQL server port"
        },
        {
          "key": "database",
          "label": "Database",
          "type": "text",
          "placeholder": "postgres",
          "required": true,
          "helpText": "Database name to connect to"
        },
        {
          "key": "user",
          "label": "Username",
          "type": "text",
          "placeholder": "postgres",
          "required": true,
          "helpText": "Database user"
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "placeholder": "",
          "required": false,
          "helpText": "Database password (leave empty if not required)"
        },
        {
          "key": "ssl_mode",
          "label": "SSL Mode",
          "type": "select",
          "defaultValue": "disable",
          "required": false,
          "options": ["disable", "require", "verify-ca", "verify-full"],
          "helpText": "SSL connection mode"
        }
      ],
      "features": {
        "supportsSSL": true,
        "supportsMultipleDB": true,
        "supportsSchemas": true,
        "supportsProcedures": true,
        "supportsFunctions": true,
        "supportsViews": true
      }
    },
